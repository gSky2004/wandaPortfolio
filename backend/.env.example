PORT=5001
NODE_ENV=development

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=kali

# Optional pool tuning (defaults shown)
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_POOL_MAX=10

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Default admin (used by seed script — re-run `npm run seed` after changing)
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin

# Notifications: alerts for new contact / speaking-invite submissions.
# Leave blank to disable a channel (forms still save to the inbox).
# SMTP_* — Gmail example: host smtp.gmail.com, port 587, secure false,
# user/address + an App Password (Google Account → Security → App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Inbox that receives the alerts (defaults to SMTP_USER when empty).
NOTIFY_EMAIL=
# WhatsApp alerts via CallMeBot: provider must be `callmebot`, key from
# callmebot.com, WHATSAPP_TO is the recipient number in international format.
# The recipient phone must first send "I allow callmebot to send me messages"
# to the CallMeBot bot number, or alerts silently fail.
WHATSAPP_PROVIDER=
CALLMEBOT_API_KEY=
WHATSAPP_TO=
